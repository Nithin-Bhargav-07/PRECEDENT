# PRECEDENT Backend Environment Configuration

# Application
APP_NAME=PRECEDENT
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# AI Provider
# Options: granite, gemini, groq
# Leave empty to use the local development fallback
AI_PROVIDER=

# Google Gemini (secondary provider)
GEMINI_API_KEY=
GEMINI_MODEL_ID=

# Groq (secondary provider)
GROQ_API_KEY=
GROQ_MODEL_ID=

# IBM watsonx.ai (IBM Granite)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=

# Data paths
CASES_DATA_PATH=data/cases.json
SESSIONS_DATA_PATH=data/sessions.json
FACTOR_SCHEMA_PATH=data/schema.json

# Reasoning engine thresholds
ABSTENTION_THRESHOLD=2.0
ABSTENTION_THRESHOLD_SINGLE_FACTOR=1.0

# Optional vector search (disabled by default)
VECTOR_SEARCH_ENABLED=false
